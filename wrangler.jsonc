{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mywebsite",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/weekly-image*"]
  },
  "observability": {
    "enabled": true
  }
}
